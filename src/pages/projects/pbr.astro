---
import Layout from '../../layouts/Layout.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
---

<Layout title="PBR - Lina">

<ProjectHeader slug="pbr" />

<main class="project-page max-w-[1432px] mx-auto px-6 md:pl-[244px] md:pr-12 pt-0 pb-[92px]">

    <!-- Body sections to be filled in -->
    <section class="mb-10">
      <h2 class="font-semibold text-neutral-900 mb-4" style="font-size: 20px;">Overview</h2>
      <p class="text-neutral-700 text-sm leading-7">
        PBR.studio turns a single photo or prompt into a ready-to-use PBR texture set including albedo, normal, roughness, and more, without the manual baking pipeline.
      </p>
    </section>

  </main>
</Layout>
