---
import Layout from '../layouts/Layout.astro';
import IntroSection from '../components/IntroSection.astro';

const HEADER_PX = 106;

type Card = {
  slug: string;
  title: string;
  hover: string;
  href?: string;
  external?: boolean;
  left: number;
  top: number;
  width: number;
  height: number;
};

const cards: Card[] = [
  { slug: 'pbr',          title: 'PBR',          hover: '/Hove PBR.PNG',           href: 'https://pbr.studio', external: true, left: 13.5, top: 18, width: 12, height: 27.7 },
  { slug: 'bambi',        title: 'Bambi',        hover: '/Hover bamabi.PNG',       left: 30.7, top: 14, width: 8, height: 33.2 },
  { slug: 'alblatta',     title: "Al'Blatta",    hover: '/Hover Al Blatta .PNG',   left: 71.9, top: 9.2, width: 12, height: 27.7 },
  { slug: 'career-track', title: 'Career Track', hover: '/Hover Career Track.PNG', left: 49.8, top: 12.1, width: 12, height: 33.2 },
  { slug: 'construct',    title: 'Construct',    hover: '/Hover Construct.PNG',    left: 86.5, top: 20.1, width: 12, height: 31.9 },
];
---

<Layout hideFooter>
  <IntroSection />
  <main
    id="home-scroller"
    class="overflow-x-auto overflow-y-hidden scrollbar-hide bg-[#F5F5F0]"
    style={`height: calc(100vh - ${HEADER_PX}px);`}
  >
    <div class="relative h-full w-max">
      <img
        src="/Home page .PNG"
        alt="Gallery of Lina's projects"
        class="h-full w-auto max-w-none block select-none pointer-events-none"
        draggable="false"
      />

      {cards.map((c) => (
        <img
          src={c.hover}
          alt=""
          aria-hidden="true"
          data-overlay={c.slug}
          class="hover-overlay absolute top-0 left-0 h-full w-auto max-w-none block select-none pointer-events-none"
          draggable="false"
        />
      ))}

      {cards.map((c) => (
        <a
          href={c.href ?? `/projects/${c.slug}`}
          target={c.external ? '_blank' : undefined}
          rel={c.external ? 'noopener noreferrer' : undefined}
          aria-label={c.title}
          data-hotspot={c.slug}
          class="hotspot absolute rounded-md"
          style={`left:${c.left}%; top:${c.top}%; width:${c.width}%; height:${c.height}%`}
        >
          <span class="sr-only">{c.title}</span>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .hover-overlay {
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .hover-overlay.is-active {
    opacity: 1;
  }
</style>

<script>
  function bindHomeScroller() {
    const scroller = document.getElementById('home-scroller');
    if (!scroller) return;

    scroller.scrollLeft = 0;
    window.scrollTo(0, 0);

    const onWheel = (e: WheelEvent) => {
      if (e.deltaY === 0 || e.shiftKey) return;
      e.preventDefault();
      scroller.scrollLeft += e.deltaY;
    };
    scroller.addEventListener('wheel', onWheel, { passive: false });

    document.querySelectorAll<HTMLElement>('[data-hotspot]').forEach((spot) => {
      const slug = spot.dataset.hotspot;
      if (!slug) return;
      const overlay = document.querySelector(`[data-overlay="${slug}"]`);
      if (!overlay) return;
      spot.addEventListener('mouseenter', () => overlay.classList.add('is-active'));
      spot.addEventListener('mouseleave', () => overlay.classList.remove('is-active'));
    });
  }

  bindHomeScroller();
  document.addEventListener('astro:page-load', bindHomeScroller);
</script>
